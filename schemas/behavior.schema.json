{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavior.schema.json",
  "title": "BehaviorContract",
  "type": "object",
  "required": ["id", "status", "title", "scenario", "system_elements", "preconditions", "inputs", "outputs", "states", "transitions", "runtime_invariants", "failure_modes", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^BEH-[0-9]{3,}$"},
    "status": {"enum": ["PROPOSED", "APPROVED", "SUPERSEDED", "DEPRECATED"]},
    "title": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "system_elements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "typed-reference.schema.json"}
    },
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^command\\.[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "idempotency": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^event\\.[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "ordering": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^state\\.[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "terminal": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "trigger", "target"],
        "properties": {
          "id": {"type": "string", "pattern": "^transition\\.[a-z][a-z0-9_]*$"},
          "source": {"type": "string", "pattern": "^state\\.[a-z][a-z0-9_]*$"},
          "trigger": {"type": "string", "minLength": 1},
          "guard": {"type": ["string", "null"]},
          "target": {"type": "string", "pattern": "^state\\.[a-z][a-z0-9_]*$"},
          "effect": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "runtime_invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "condition", "target"],
        "properties": {
          "id": {"type": "string", "pattern": "^invariant\\.[a-z][a-z0-9_]*$"},
          "condition": {"type": "string", "minLength": 1},
          "target": {"$ref": "typed-reference.schema.json"}
        },
        "additionalProperties": false
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "condition", "detection", "action", "resulting_state"],
        "properties": {
          "id": {"type": "string", "pattern": "^failure\\.[a-z][a-z0-9_]*$"},
          "condition": {"type": "string", "minLength": 1},
          "detection": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "resulting_state": {"type": "string", "pattern": "^state\\.[a-z][a-z0-9_]*$"},
          "retry": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["criteria"],
      "properties": {
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "items": {"$ref": "typed-reference.schema.json"}}
      },
      "additionalProperties": false
    },
    "traceability": {
      "type": "array",
      "items": {"$ref": "typed-reference.schema.json"}
    },
    "superseded_by": {"type": ["string", "null"], "pattern": "^BEH-[0-9]{3,}$"}
  },
  "additionalProperties": false
}
