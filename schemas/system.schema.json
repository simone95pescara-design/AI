{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system.schema.json",
  "title": "SystemSpecification",
  "type": "object",
  "required": ["id", "status", "title", "purpose", "boundary", "capabilities", "components", "interfaces", "data", "configuration", "traceability"],
  "properties": {
    "id": {"type": "string", "pattern": "^SYS-[0-9]{3,}$"},
    "status": {"enum": ["PROPOSED", "APPROVED", "SUPERSEDED", "DEPRECATED"]},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "boundary": {
      "type": "object",
      "required": ["in_scope", "out_of_scope", "external_actors"],
      "properties": {
        "in_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "external_actors": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "responsibility", "owner_component"],
        "properties": {
          "id": {"type": "string", "pattern": "^capability\\.[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "owner_component": {"type": "string", "pattern": "^component\\.[a-z][a-z0-9_]*$"}
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "responsibilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^component\\.[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "implementation": {"type": "array", "items": {"$ref": "typed-reference.schema.json"}}
        },
        "additionalProperties": false
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "consumer", "contract"],
        "properties": {
          "id": {"type": "string", "pattern": "^interface\\.[a-z][a-z0-9_]*$"},
          "provider": {"type": "string", "minLength": 1},
          "consumer": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "owner", "semantics"],
        "properties": {
          "id": {"type": "string", "pattern": "^data\\.[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "semantics": {"type": "string", "minLength": 1},
          "units": {"type": ["string", "null"]},
          "precision": {"type": ["string", "null"]},
          "temporal_semantics": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "behavioral_effect"],
        "properties": {
          "id": {"type": "string", "pattern": "^config\\.[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "behavioral_effect": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "array",
      "items": {"$ref": "typed-reference.schema.json"}
    },
    "superseded_by": {"type": ["string", "null"], "pattern": "^SYS-[0-9]{3,}$"}
  },
  "additionalProperties": false
}
