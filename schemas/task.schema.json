{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "required": ["id", "status", "title", "objective", "scope", "baseline", "authority", "verification_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "status": {"enum": ["TODO", "READY", "DOING", "BLOCKED", "DONE", "CANCELLED"]},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "baseline": {"type": "string", "minLength": 1},
    "authority": {"enum": ["A0", "A1", "A2", "A3", "A4"]},
    "owner": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "verification_status": {"enum": ["UNKNOWN", "NOT_REQUIRED", "PARTIAL", "PASSED", "FAILED"]},
    "verification_refs": {"type": "array", "items": {"type": "string", "pattern": "^VER-[0-9]{3,}$"}},
    "queue_source": {"type": ["string", "null"], "pattern": "^QUEUE-[0-9]{3,}$"},
    "related_requirements": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}},
    "related_decisions": {"type": "array", "items": {"type": "string", "pattern": "^DEC-[0-9]{3,}$"}},
    "next_action": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
